# Ollama 本地模型服务器地址
OLLAMA_BASE_URL=http://localhost:11434

# 阿里云 DashScope API Key（可选，用于云端翻译）
DASHSCOPE_API_KEY=

# VS Code 调试时加载环境变量
# Mac/Linux: source .env && python video_localizer.py
# Windows PowerShell: Get-Content .env | ForEach-Object { $_.Split('=', 2) | ForEach-Object { Set-Content "env:$($_[0])" $_[1] } }; python video_localizer.py
